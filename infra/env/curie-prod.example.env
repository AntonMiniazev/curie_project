APP_ENV=prod

POSTGRES_DB=curie
POSTGRES_USER=curie_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

CURIE_DATABASE_URL=postgresql+psycopg://curie_app:change-me@postgres:5432/curie
CURIE_CORS_ORIGINS=change-me

CURIE_UC_BASE_URL=change-me
CURIE_UC_TIMEOUT_SECONDS=10
CURIE_SOURCE_CATALOG=change-me
CURIE_SOURCE_SCHEMA=change-me
CURIE_SOURCE_TABLES=change-me

CURIE_MINIO_ENDPOINT=change-me
CURIE_MINIO_REGION=us-east-1
CURIE_MINIO_ACCESS_KEY=change-me
CURIE_MINIO_SECRET_KEY=change-me
CURIE_MINIO_ALLOW_INVALID_CERTIFICATES=true

CURIE_CACHE_ROOT=/app/data/cache
CURIE_CACHE_CURRENT=/app/data/cache/current
CURIE_HOST_CACHE_DIR=/var/lib/curie/cache
CURIE_API_PORT=change-me
CURIE_POSTGRES_PORT=change-me
CURIE_UPSTREAM_HOST_IP=change-me

CURIE_PASSWORD_PEPPER=change-me
CURIE_JWT_SECRET_KEY=change-me
CURIE_JWT_ALGORITHM=HS256
CURIE_ACCESS_TOKEN_MINUTES=60
CURIE_REFRESH_TOKEN_DAYS=14
CURIE_AUTH_ACCESS_COOKIE_NAME=curie_access_token
CURIE_AUTH_REFRESH_COOKIE_NAME=curie_refresh_token
CURIE_AUTH_COOKIE_SECURE=true
CURIE_AUTH_COOKIE_SAMESITE=lax
CURIE_ADMIN_API_KEYS=change-me
