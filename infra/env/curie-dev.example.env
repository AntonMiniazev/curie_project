APP_ENV=dev

POSTGRES_DB=curie_dev
POSTGRES_USER=curie_dev
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

CURIE_DATABASE_URL=postgresql+psycopg://curie_dev:change-me@localhost:5432/curie_dev
CURIE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CURIE_UC_BASE_URL=https://ucatalog.local
CURIE_UC_TIMEOUT_SECONDS=10
CURIE_UC_RETRY_ATTEMPTS=5
CURIE_UC_RETRY_BACKOFF_SECONDS=5
CURIE_SOURCE_CATALOG=ampere
CURIE_SOURCE_SCHEMA=gold
CURIE_SOURCE_TABLES=fct_orders_sales

CURIE_MINIO_ENDPOINT=https://s3.minio.local
CURIE_MINIO_REGION=us-east-1
CURIE_MINIO_ACCESS_KEY=change-me
CURIE_MINIO_SECRET_KEY=change-me
CURIE_MINIO_ALLOW_INVALID_CERTIFICATES=true

CURIE_CACHE_ROOT=data/dev-cache
CURIE_CACHE_CURRENT=data/dev-cache/current
CURIE_UPSTREAM_HOST_IP=192.168.1.29

CURIE_PASSWORD_PEPPER=change-me
CURIE_JWT_SECRET_KEY=change-me
CURIE_JWT_ALGORITHM=HS256
CURIE_ACCESS_TOKEN_MINUTES=60
CURIE_REFRESH_TOKEN_DAYS=14
CURIE_AUTH_ACCESS_COOKIE_NAME=curie_access_token
CURIE_AUTH_REFRESH_COOKIE_NAME=curie_refresh_token
CURIE_AUTH_COOKIE_SECURE=false
CURIE_AUTH_COOKIE_SAMESITE=lax
CURIE_ADMIN_API_KEYS=dev-admin-key
