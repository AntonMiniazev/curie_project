{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/meta/capabilities": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Get Capabilities",
        "operationId": "get_capabilities_api_meta_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Get Reports",
        "operationId": "get_reports_api_reports_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cache/status": {
      "get": {
        "tags": [
          "cache"
        ],
        "summary": "Get Cache Status",
        "operationId": "get_cache_status_api_cache_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CacheStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cache/refresh": {
      "post": {
        "tags": [
          "cache"
        ],
        "summary": "Refresh Cache Endpoint",
        "operationId": "refresh_cache_endpoint_api_cache_refresh_post",
        "parameters": [
          {
            "name": "X-Curie-Admin-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Curie-Admin-Key"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CacheRefreshAcceptedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/roles": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Get Available Roles",
        "description": "Return public roles that a new user can select during registration.",
        "operationId": "get_available_roles_api_auth_roles_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailableRolesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register User",
        "description": "Create a user, assign the selected role, and return access/refresh tokens.",
        "operationId": "register_user_api_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login User",
        "description": "Verify user credentials and return access/refresh tokens.",
        "operationId": "login_user_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Get Current User",
        "description": "Return the current user represented by a valid session cookie.",
        "operationId": "get_current_user_api_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/nginx-streamlit": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Nginx Streamlit Auth",
        "description": "Validate a browser session for Nginx `auth_request` and return signed Streamlit scope.",
        "operationId": "nginx_streamlit_auth_api_auth_nginx_streamlit_get",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh Access Token",
        "description": "Use a valid refresh token to issue a new access token.",
        "operationId": "refresh_access_token_api_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/RefreshTokenRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout User",
        "description": "Revoke a refresh token so it cannot be used again.",
        "operationId": "logout_user_api_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/LogoutRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AvailableRoleResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "short_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Short Description"
          }
        },
        "type": "object",
        "required": [
          "name",
          "label",
          "description",
          "short_description"
        ],
        "title": "AvailableRoleResponse",
        "description": "Single public role option that the frontend can show during registration."
      },
      "AvailableRolesResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AvailableRoleResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "items",
          "count"
        ],
        "title": "AvailableRolesResponse",
        "description": "List response containing all roles that a new user is allowed to select."
      },
      "CacheRefreshAcceptedResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "title": "CacheRefreshAcceptedResponse"
      },
      "CacheStatusResponse": {
        "properties": {
          "configured": {
            "type": "boolean",
            "title": "Configured"
          },
          "active_release_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Release Id"
          },
          "tables": {
            "items": {
              "$ref": "#/components/schemas/CacheTableStatus"
            },
            "type": "array",
            "title": "Tables"
          }
        },
        "type": "object",
        "required": [
          "configured",
          "active_release_id",
          "tables"
        ],
        "title": "CacheStatusResponse"
      },
      "CacheTableStatus": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "source_table": {
            "type": "string",
            "title": "Source Table"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "schema_path": {
            "type": "string",
            "title": "Schema Path"
          },
          "row_count": {
            "type": "integer",
            "title": "Row Count"
          },
          "checksum": {
            "type": "string",
            "title": "Checksum"
          }
        },
        "type": "object",
        "required": [
          "name",
          "source_table",
          "path",
          "schema_path",
          "row_count",
          "checksum"
        ],
        "title": "CacheTableStatus"
      },
      "CurrentUserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles"
          },
          "role_descriptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Role Descriptions"
          },
          "role_short_descriptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Role Short Descriptions"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "is_verified": {
            "type": "boolean",
            "title": "Is Verified"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "created_at",
          "roles",
          "role_descriptions",
          "role_short_descriptions",
          "is_active",
          "is_verified"
        ],
        "title": "CurrentUserResponse",
        "description": "Response body describing the authenticated user resolved from a valid access token."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LogoutRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 1,
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "LogoutRequest",
        "description": "Request body for revoking a refresh token during logout."
      },
      "MetaResponse": {
        "properties": {
          "app": {
            "type": "string",
            "title": "App"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Features"
          }
        },
        "type": "object",
        "required": [
          "app",
          "environment",
          "features"
        ],
        "title": "MetaResponse"
      },
      "RefreshTokenRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 1,
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshTokenRequest",
        "description": "Request body for getting a new access token using a valid refresh token."
      },
      "ReportItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "streamlit_path": {
            "type": "string",
            "title": "Streamlit Path"
          },
          "required_role": {
            "type": "string",
            "title": "Required Role"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "sort_order": {
            "type": "integer",
            "title": "Sort Order"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "category",
          "streamlit_path",
          "required_role",
          "enabled",
          "sort_order"
        ],
        "title": "ReportItem"
      },
      "ReportsResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReportItem"
            },
            "type": "array",
            "title": "Items"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "items",
          "count"
        ],
        "title": "ReportsResponse"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "expires_in_seconds": {
            "type": "integer",
            "title": "Expires In Seconds"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "expires_in_seconds"
        ],
        "title": "TokenResponse",
        "description": "Response body returned after register, login, or token refresh with session token details."
      },
      "UserCreateRequest": {
        "properties": {
          "role": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Role"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 5,
            "title": "Password"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "role",
          "email",
          "password"
        ],
        "title": "UserCreateRequest",
        "description": "Request body for registering a new user with email, password, display name, and selected role."
      },
      "UserLoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "UserLoginRequest",
        "description": "Request body for logging in an existing user with email and password."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
