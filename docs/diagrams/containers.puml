@startuml CurieContainers
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()
HIDE_STEREOTYPE()

Person(visitor, "Website Visitor", "Authenticates and opens report pages")
Person(dev, "Developer", "Runs local development and production deployment")

System_Ext(ghcr, "GHCR", "Stores Curie container images")
System_Ext(ampereGold, "Ampere Flight SQL", "Authenticated read-only Gold queries over Tailscale")

System_Boundary(curie, "Curie") {
    Container(web, "SvelteKit Web", "SvelteKit", "Project hub, Curie auth screens, and report page templates")
    Container(api, "FastAPI API", "Python/FastAPI", "Auth, report metadata, cache status, and cache job trigger endpoints")
    Container(db, "PostgreSQL", "PostgreSQL", "Users, roles, reports, refresh tokens, and API metadata")
    Container(cacheWorker, "Cache Refresh Worker", "Python/ADBC/DuckDB", "Streams Gold Arrow batches into a temporary DuckDB release, validates and activates it, then exits")
    Container(cacheFiles, "Local Serving Cache", "DuckDB", "Durable current release and retained previous releases")
    Container(streamlit, "Streamlit Reports", "Streamlit/DuckDB", "Scoped local report queries embedded from Curie pages")
}

Rel(visitor, web, "Uses", "Browser")
Rel(web, api, "Calls", "HTTP + secure cookies")
Rel(web, streamlit, "Embeds report apps", "iframe")
Rel(api, db, "Reads/writes", "SQLAlchemy")
Rel(api, cacheWorker, "Starts refresh job", "Docker")
Rel(cacheWorker, ampereGold, "Runs fixed authenticated Gold queries", "Flight SQL/ADBC")
Rel(cacheWorker, cacheFiles, "Atomically activates validated release", "DuckDB file")
Rel(api, cacheFiles, "Reads cache status", "Filesystem")
Rel(streamlit, cacheFiles, "Reads active release with store scope", "Read-only DuckDB")
Rel(dev, ghcr, "Publishes images", "GitHub Actions")
Rel(ghcr, api, "Provides image", "Docker pull")
Rel(ghcr, cacheWorker, "Provides image", "Docker pull")

SHOW_LEGEND()
@enduml
